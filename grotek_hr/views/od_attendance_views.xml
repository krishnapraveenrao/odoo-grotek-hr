<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_attendance_view_list" model="ir.ui.view">
        <field name="name">grotek.od.attendance.list</field>
        <field name="model">grotek.od.attendance</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'rejected'" decoration-info="state == 'submitted'">
                <field name="employee_id"/>
                <field name="manager_id" optional="show"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="reason"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="od_attendance_view_form" model="ir.ui.view">
        <field name="name">grotek.od.attendance.form</field>
        <field name="model">grotek.od.attendance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Send for approval" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_draft" type="object" string="Back to draft" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="check_in" readonly="state not in ('draft', 'submitted')"/>
                            <field name="check_out" readonly="state not in ('draft', 'submitted')"/>
                            <field name="worked_hours" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state not in ('draft', 'submitted')"/>
                        <field name="reject_reason" invisible="state != 'rejected'"/>
                        <field name="approved_by_id" invisible="not approved_by_id"/>
                        <field name="attendance_id" invisible="not attendance_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="od_attendance_view_search" model="ir.ui.view">
        <field name="name">grotek.od.attendance.search</field>
        <field name="model">grotek.od.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <filter name="to_approve" string="To approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="mine" string="Mine" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="my_team" string="My team" domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <group>
                    <filter name="by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="od_attendance_action" model="ir.actions.act_window">
        <field name="name">OD attendance</field>
        <field name="res_model">grotek.od.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask for on-duty attendance</p>
            <p>Worked away from the biometric device? Enter the check-in and check-out times and the reason.
               When your manager approves, the attendance line is created.</p>
        </field>
    </record>
</odoo>
